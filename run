#!/usr/bin/env bash
# Linux (incl. WSL) and macOS runner; Windows has run.ps1.

cd "$(dirname "$0")" || exit 1

PULL='.pull'
SUB='.submodules'

case $1 in
    clean)
        echo pull and update submodules
        rm -f $PULL $SUB
        shift
        ;;
    *)
        ;;
esac


find . -maxdepth 1 -name $PULL -mtime +1 -delete
if [ ! -f $PULL ]; then
    echo pull latest changes
    git pull
    touch $PULL
fi

find . -maxdepth 1 -name $SUB -mtime +7 -delete

PUPPET_MODULES=''

if [[ $OSTYPE == 'darwin'* ]]; then
    PUPPET_INSTALL='puppet module install'
    PUPPET_APPLY='puppet apply -v'
    PUPPET_MODULES=":$HOME/.puppetlabs/etc/code/modules/"
else
    PUPPET_MODULES=":/etc/puppetlabs/code/modules/"
    if [ -e /bin/sudo ]; then
        PUPPET_INSTALL='sudo puppet module install'
        PUPPET_APPLY='sudo puppet apply -v'
    else
        PUPPET_INSTALL='puppet module install'
        PUPPET_APPLY='puppet apply -v'
    fi
fi



if [ ! -f $SUB ]; then
    echo update submodules
    ${PUPPET_INSTALL} puppetlabs-stdlib
    ${PUPPET_INSTALL} puppetlabs-vcsrepo

    touch $SUB
fi

# macFUSE (needed by encfs) is a .pkg cask that asks for sudo; puppet execs run
# without a tty and can't prompt, so install it here interactively once.
if [[ $OSTYPE == 'darwin'* && ! -d /Library/Filesystems/macfuse.fs ]]; then
    echo install macfuse
    /opt/homebrew/bin/brew install --cask macfuse
fi

if [[ -f ~/.keys/env ]]; then
    source ~/.keys/common_env
fi

sshj_fact="${FACTER_SSHJ_FACT:-}"
if [[ -z $sshj_fact && -n $FACTER_SSHJ_SPEC ]]; then
    sshj_fact="$FACTER_SSHJ_SPEC"
fi

if [[ -n $sshj_fact ]]; then
    if [[ $OSTYPE == 'darwin'* ]]; then
        export FACTER_SSHJ_FACT="$sshj_fact"
        export PUPPET_APPLY="puppet apply -v"
    else
        export PUPPET_APPLY="sudo FACTER_SSHJ_FACT=${sshj_fact} puppet apply -v"
    fi
fi

set -x
${PUPPET_APPLY} \
    --modulepath `pwd`/modules${PUPPET_MODULES} \
    manifests/hosts.pp $@
{ set +x; } 2>/dev/null

# Root-only macOS setup (kpi::darwin::system: Touch ID sudo, Spotlight off).
# Puppet runs as the user here, so escalate only when something there is out of
# date. Needs pam_reattach, which the apply above installs.
if [[ $OSTYPE == 'darwin'* && -f /opt/homebrew/lib/pam/pam_reattach.so ]]; then
    if ! grep -q pam_tid /etc/pam.d/sudo_local 2>/dev/null || ! mdutil -s / | grep -q 'Indexing disabled'; then
        echo apply root-only macOS settings
        sudo /opt/puppetlabs/bin/puppet apply -v \
            --modulepath "$(pwd)/modules${PUPPET_MODULES}" \
            -e 'include kpi::darwin::system'
    fi
fi

if [[ $OSTYPE != darwin* ]] && command -v niri_outputs.py >/dev/null 2>&1; then
    niri_pid=$(pgrep -x niri | head -1)
    if [[ -n $niri_pid ]]; then
        runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        niri_socket=$(ls -1t "$runtime_dir"/niri.wayland-*."$niri_pid".sock 2>/dev/null | head -1)
        if [[ -n $niri_socket ]]; then
            NIRI_SOCKET="$niri_socket" niri_outputs.py || true
        fi
    fi
fi
