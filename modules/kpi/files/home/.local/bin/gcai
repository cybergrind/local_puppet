#!/usr/bin/env python3
"""Commit the staged changes with a one-line message written by claude.

The message follows the style of the repo's recent subjects. It is shown first
and committed only after a y.
"""

import argparse
import os
import subprocess
import sys


PROMPT = """Write a one-line git commit message for this staged diff.
Match the style of these recent commit subjects:
{subjects}

Preferred format:
<area>: <summary>

Reply with the message only: one line, no semicolons, no quotes, no prefix, no trailing period.
Only simple words, max 80 symbols.
"""


# the diff sent to claude is cut here, after a --stat of all of it
MAX_DIFF = 100_000


def git_bytes(*args, check=True):
    return subprocess.run(['git', *args], capture_output=True, check=check).stdout


def git(*args, check=True):
    return git_bytes(*args, check=check).decode(errors='replace')


def staged_diff():
    """The staged diff of text files; binary ones, by git or by not being utf-8, are only named."""
    numstat = os.fsdecode(git_bytes('diff', '--cached', '--no-renames', '--numstat', '-z'))
    parts, binaries = [], []
    for entry in filter(None, numstat.split('\0')):
        added, _, path = entry.split('\t', 2)
        if added != '-':
            try:
                parts.append(git_bytes('diff', '--cached', '--', path).decode())
                continue
            except UnicodeDecodeError:
                pass
        binaries.append(path)
    if binaries:
        parts.append('Binary files changed:\n' + ''.join(f'  {path}\n' for path in binaries))
    return ''.join(parts)


def first_line(reply):
    """The first non-empty line, without blanks, quotes or a trailing period around it."""
    lines = [line for line in reply.splitlines() if line.strip()]
    if not lines:
        return ''
    msg = lines[0].lstrip(' \t\'"`')
    while msg and msg[-1] in ' \t\'"`.':
        msg = msg[:-1]
    return msg


def ask(question):
    """y/N with a single key press on a terminal, a line otherwise."""
    if not sys.stdin.isatty():
        print(question, end=' ', flush=True)
        return sys.stdin.readline().strip().lower() == 'y'
    import termios
    import tty

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        # cbreak before the prompt, so a key typed right away isn't held for Enter
        tty.setcbreak(fd)
        print(question, end=' ', flush=True)
        key = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    print(key)
    return key.lower() == 'y'


def parse_args():
    parser = argparse.ArgumentParser(
        description=__doc__.split('\n\n')[0],
        epilog='Any other arguments are passed on to git commit.',
    )
    parser.add_argument('-n', '--no-verify', action='store_true', help='skip the commit hooks (git commit -n)')
    return parser.parse_known_args()


def main():
    args, commit_args = parse_args()
    if args.no_verify:
        commit_args.insert(0, '--no-verify')

    try:
        diff = staged_diff()
    except subprocess.CalledProcessError as e:
        sys.exit(e.stderr.decode(errors='replace').strip())
    if not diff.strip():
        sys.exit('nothing staged')
    if len(diff) > MAX_DIFF:
        diff = git('diff', '--cached', '--stat') + '\n' + diff[:MAX_DIFF] + '\n[diff truncated]\n'

    # empty in a repo without commits yet
    subjects = git('log', '-15', '--format=%s', check=False)
    try:
        reply = subprocess.run(
            ['claude', '-p', PROMPT.format(subjects=subjects)], input=diff, capture_output=True, text=True
        )
    except FileNotFoundError:
        sys.exit('claude is not on PATH')
    if reply.returncode != 0:
        sys.exit(reply.stderr.strip() or f'claude exited with {reply.returncode}')

    msg = first_line(reply.stdout)
    if not msg:
        sys.exit('claude returned no message')
    print(msg)
    if ask('commit with this message? [y/N]'):
        os.execvp('git', ['git', 'commit', *commit_args, '-m', msg])


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
