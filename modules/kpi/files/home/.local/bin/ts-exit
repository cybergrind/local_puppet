#!/usr/bin/env -S uv run -q --script
# /// script
# requires-python = ">=3.14"
# dependencies = [
#   "textual>=1.0",
# ]
# ///
"""TUI to pick a Tailscale exit node, ordered by distance, with estimated latency.

Distance is computed from your preferred DERP region's coordinates (geoip would
report the active exit node's location, the DERP relay choice is unaffected).
Latency per node is estimated as your RTT to the DERP region nearest to that
node, measured with STUN probes to every DERP region. Mullvad nodes do not
answer direct pings unless selected, so this is the best cheap signal available;
the selected exit node is pinged at its real endpoint instead.

All probes are sent over the LAN uplink: the interface behind the main routing
table's default gateway (e.g. 192.168.88.1), not the system default route. With
an exit node active the system route is table 52 -> tailscale0, and probing
through the tunnel would measure the exit node's vantage point, not yours.
Use --gateway to pick the uplink when several default routes exist.

Keys: enter=set exit node, x=clear, s=use suggested, a=all nodes/per-city,
d/l=sort by distance/latency, /=filter, r=refresh, q=quit.
Run with --dump for a plain-text listing instead of the TUI.
"""

from __future__ import annotations

import argparse
import asyncio
import contextlib
import json
import math
import os
import re
import socket
import struct
import time
import zlib
from dataclasses import dataclass
from typing import ClassVar

from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.widgets import DataTable, Footer, Input


SUGGEST_RE = re.compile(r'Suggested exit node: (\S+?)\.?\s')
PING_RE = re.compile(r'= [\d.]+/([\d.]+)/')
STUN_COOKIE = 0x2112A442
STUN_PORT = 3478


@dataclass
class Node:
    name: str  # DNS name without trailing dot, used for `tailscale set`
    host: str
    country: str
    city: str
    lat: float | None
    lon: float | None
    priority: int
    online: bool
    is_exit: bool
    endpoint: str | None  # public IP of the WireGuard endpoint, known only while the node is in use
    distance: float | None = None
    est_ms: float | None = None


@dataclass
class Region:
    lat: float
    lon: float
    stun: tuple[str, int] | None  # IPv4 STUN server of one node in the region


@dataclass
class Uplink:
    dev: str
    gateway: str


async def tailscale(*args: str) -> tuple[int, str, str]:
    proc = await asyncio.create_subprocess_exec(
        'tailscale', *args, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
    )
    out, err = await proc.communicate()
    return proc.returncode or 0, out.decode(), err.decode()


def haversine(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    p1, p2 = math.radians(lat1), math.radians(lat2)
    h = math.sin((p2 - p1) / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(math.radians(lon2 - lon1) / 2) ** 2
    return 2 * 6371.0 * math.asin(math.sqrt(h))


def parse_nodes(status: dict) -> list[Node]:
    nodes = []
    for peer in (status.get('Peer') or {}).values():
        if not peer.get('ExitNodeOption'):
            continue
        loc = peer.get('Location') or {}
        nodes.append(
            Node(
                name=peer['DNSName'].rstrip('.'),
                host=peer['HostName'],
                country=loc.get('Country', ''),
                city=loc.get('City', ''),
                lat=loc.get('Latitude'),
                lon=loc.get('Longitude'),
                priority=loc.get('Priority', 0),
                online=peer.get('Online', False),
                is_exit=peer.get('ExitNode', False),
                endpoint=peer['CurAddr'].rsplit(':', 1)[0] if peer.get('CurAddr') else None,
            )
        )
    return nodes


def parse_regions(derp: dict) -> dict[int, Region]:
    regions = {}
    for rid, region in (derp.get('Regions') or {}).items():
        stun = None
        for node in region.get('Nodes') or []:
            if node.get('IPv4') and node.get('STUNPort', 0) != -1:
                stun = (node['IPv4'], node.get('STUNPort') or STUN_PORT)
                break
        regions[int(rid)] = Region(region['Latitude'], region['Longitude'], stun)
    return regions


async def lan_uplink(gateway: str | None = None) -> Uplink | None:
    """Interface + gateway of the main table's default route, i.e. the physical uplink tailscale's table 52 hides.

    With several default routes the lowest metric wins unless `gateway` pins one. None on non-Linux or offline hosts.
    """
    try:
        proc = await asyncio.create_subprocess_exec(
            'ip',
            '-j',
            'route',
            'show',
            'table',
            'main',
            'default',
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
    except FileNotFoundError:
        return None
    out, _ = await proc.communicate()
    routes = [r for r in json.loads(out or b'[]') if r.get('gateway') and gateway in (None, r['gateway'])]
    if not routes:
        return None
    best = min(routes, key=lambda r: r.get('metric', 0))
    return Uplink(best['dev'], best['gateway'])


async def load_nodes() -> tuple[list[Node], dict[int, Region]]:
    """Returns exit-node peers with distances filled in, and the DERP region map."""
    (_, status_out, _), (_, derp_out, _) = await asyncio.gather(
        tailscale('status', '--json'), tailscale('debug', 'derp-map')
    )
    status = json.loads(status_out)
    regions: dict[int, Region] = {}
    my_pos = None
    try:
        derp = json.loads(derp_out)
        regions = parse_regions(derp)
        for rid, region in (derp.get('Regions') or {}).items():
            if region.get('RegionCode') == status.get('Self', {}).get('Relay'):
                my_pos = regions[int(rid)]
    except json.JSONDecodeError, KeyError:
        pass

    nodes = parse_nodes(status)
    if my_pos:
        for node in nodes:
            if node.lat is not None:
                node.distance = haversine(my_pos.lat, my_pos.lon, node.lat, node.lon)
    return nodes, regions


def bound_udp_socket(uplink: Uplink | None) -> socket.socket:
    """UDP socket that leaves via the LAN uplink regardless of the exit node's default route.

    SO_BINDTODEVICE needs no privileges since Linux 5.7; the oif constraint makes the kernel skip table 52's
    `default dev tailscale0` and fall through to the main table's gateway.
    """
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    if uplink and hasattr(socket, 'SO_BINDTODEVICE'):
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, uplink.dev.encode())
    sock.setblocking(False)
    return sock


def stun_request() -> tuple[bytes, bytes]:
    """Binding request in the dialect Tailscale DERP servers accept: SOFTWARE 'tailnode' + trailing FINGERPRINT."""
    txid = os.urandom(12)
    body = struct.pack('!HH', 0x8022, 8) + b'tailnode'
    msg = struct.pack('!HHI', 0x0001, len(body) + 8, STUN_COOKIE) + txid + body
    return txid, msg + struct.pack('!HHI', 0x8028, 4, zlib.crc32(msg) ^ 0x5354554E)


class StunProbe(asyncio.DatagramProtocol):
    def __init__(self) -> None:
        self.sent: dict[bytes, float] = {}
        self.rtt: dict[bytes, float] = {}
        self.pending: set[bytes] = set()  # this round's unanswered probes
        self.round_done = asyncio.Event()

    def datagram_received(self, data: bytes, _addr: tuple) -> None:
        txid = data[8:20]
        if txid in self.sent and txid not in self.rtt:
            self.rtt[txid] = (time.perf_counter() - self.sent[txid]) * 1000
        self.pending.discard(txid)
        if not self.pending:
            self.round_done.set()


async def stun_latencies(
    regions: dict[int, Region], uplink: Uplink | None, rounds: int = 3, round_wait: float = 1.0
) -> dict[int, float]:
    """Best RTT (ms) per DERP region, probing every region in parallel over the LAN uplink."""
    targets = {rid: region.stun for rid, region in regions.items() if region.stun}
    if not targets:
        return {}
    loop = asyncio.get_running_loop()
    transport, probe = await loop.create_datagram_endpoint(StunProbe, sock=bound_udp_socket(uplink))
    owner: dict[bytes, int] = {}
    try:
        for round_no in range(rounds):
            if round_no:  # regions silent in the first round stay silent, don't let them stall every round
                answered = {owner[txid] for txid in probe.rtt}
                targets = {rid: target for rid, target in targets.items() if rid in answered}
            probe.round_done.clear()
            probe.pending.clear()
            for rid, target in targets.items():
                txid, req = stun_request()
                owner[txid] = rid
                probe.pending.add(txid)
                probe.sent[txid] = time.perf_counter()
                transport.sendto(req, target)
            with contextlib.suppress(TimeoutError):
                await asyncio.wait_for(probe.round_done.wait(), round_wait)
    finally:
        transport.close()
    best: dict[int, float] = {}
    for txid, ms in probe.rtt.items():
        best[owner[txid]] = min(best.get(owner[txid], ms), ms)
    return best


async def ping_via(host: str, uplink: Uplink | None) -> float | None:
    """Average ICMP RTT to `host` over the LAN uplink, or None if unreachable / no ping binary."""
    iface = ['-I', uplink.dev] if uplink else []
    try:
        proc = await asyncio.create_subprocess_exec(
            'ping',
            '-n',
            '-q',
            '-c',
            '3',
            '-i',
            '0.2',
            '-W',
            '1',
            *iface,
            host,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
    except FileNotFoundError:
        return None
    out, _ = await proc.communicate()
    match = PING_RE.search(out.decode())
    return float(match.group(1)) if match else None


async def estimate_latencies(nodes: list[Node], regions: dict[int, Region], uplink: Uplink | None) -> None:
    """RTT to the DERP region nearest to each node is its estimate; the active exit node gets a real ping."""
    exit_node = next((n for n in nodes if n.is_exit and n.endpoint), None)
    latency_ms, exit_ms = await asyncio.gather(
        stun_latencies(regions, uplink),
        ping_via(exit_node.endpoint, uplink) if exit_node else asyncio.sleep(0, None),
    )
    measured = {rid: regions[rid] for rid in latency_ms}
    for node in nodes:
        if node.lat is None or not measured:
            continue
        nearest = min(measured, key=lambda rid: haversine(node.lat, node.lon, measured[rid].lat, measured[rid].lon))
        node.est_ms = latency_ms[nearest]
    if exit_node and exit_ms is not None:
        exit_node.est_ms = exit_ms


def collapse_by_city(nodes: list[Node]) -> list[Node]:
    """One node per city: prefer online, then the highest Mullvad priority. Locationless nodes pass through."""
    best: dict[tuple, Node] = {}
    for node in nodes:
        key = (node.country, node.city) if node.city else (node.name,)
        if key not in best or (node.online, node.priority) > (best[key].online, best[key].priority):
            best[key] = node
    return list(best.values())


def sort_nodes(nodes: list[Node], by: str) -> list[Node]:
    if by == 'latency':
        return sorted(nodes, key=lambda n: (n.est_ms is None, n.est_ms or 0, n.distance or 0))
    # Personal exit nodes have no location; keep them on top, they are usually the interesting ones
    return sorted(nodes, key=lambda n: (n.lat is not None, n.distance or 0, -n.priority))


class ExitNodePicker(App):
    CSS = """
    Input { dock: top; }
    DataTable { height: 1fr; }
    """
    BINDINGS: ClassVar = [
        Binding('q', 'quit', 'quit'),
        Binding('x', 'clear_exit', 'no exit node'),
        Binding('s', 'use_suggested', 'suggested'),
        Binding('a', 'toggle_all', 'all/per-city'),
        Binding('d', 'sort_distance', 'by distance'),
        Binding('l', 'sort_latency', 'by latency'),
        Binding('r', 'refresh', 'refresh'),
        Binding('slash', 'focus_filter', 'filter', key_display='/'),
        Binding('escape', 'focus_table', show=False),
    ]

    def __init__(self, gateway: str | None = None) -> None:
        super().__init__()
        self.gateway = gateway
        self.uplink: Uplink | None = None
        self.nodes: list[Node] = []
        self.regions: dict[int, Region] = {}
        self.suggested: str | None = None
        self.show_all = False
        self.sort_by = 'distance'

    def compose(self) -> ComposeResult:
        yield Input(placeholder='filter country / city / node…')
        yield DataTable(cursor_type='row')
        yield Footer()

    def on_mount(self) -> None:
        table = self.query_one(DataTable)
        table.add_columns('', 'country', 'city', 'node', 'km', '~ms')
        table.focus()
        self.title = 'tailscale exit node'
        self.run_worker(self.load(), exclusive=True)

    async def load(self) -> None:
        self.sub_title = 'loading…'
        (self.nodes, self.regions), self.uplink = await asyncio.gather(load_nodes(), lan_uplink(self.gateway))
        self.repopulate()
        self.sub_title = f'{len(self.nodes)} nodes · measuring latency via {self.uplink_label()}…'
        await asyncio.gather(self.fetch_suggestion(), estimate_latencies(self.nodes, self.regions, self.uplink))
        self.repopulate()
        self.update_subtitle()

    def uplink_label(self) -> str:
        return f'{self.uplink.gateway} ({self.uplink.dev})' if self.uplink else 'system route'

    async def fetch_suggestion(self) -> None:
        _, out, _ = await tailscale('exit-node', 'suggest')
        if match := SUGGEST_RE.search(out + ' '):
            self.suggested = match.group(1)

    def update_subtitle(self) -> None:
        current = next((n for n in self.nodes if n.is_exit), None)
        if not current:
            self.sub_title = 'no exit node'
            return
        ping = f' · {current.est_ms:.0f} ms to {current.endpoint}' if current.endpoint and current.est_ms else ''
        self.sub_title = f'exit node: {current.name}{ping} · via {self.uplink_label()}'

    def visible_nodes(self) -> list[Node]:
        nodes = self.nodes if self.show_all else collapse_by_city(self.nodes)
        if query := self.query_one(Input).value.strip().lower():
            nodes = [n for n in nodes if query in f'{n.country} {n.city} {n.name}'.lower()]
        return sort_nodes(nodes, self.sort_by)

    def repopulate(self) -> None:
        table = self.query_one(DataTable)
        previous = table.cursor_row
        table.clear()
        for node in self.visible_nodes():
            marker = '●' if node.is_exit else ('★' if node.name == self.suggested else '')
            if not node.online:
                marker = marker or '✗'
            table.add_row(
                marker,
                node.country or '—',
                node.city or '—',
                node.host,
                f'{node.distance:.0f}' if node.distance is not None else '',
                f'{node.est_ms:.0f}' if node.est_ms is not None else '',
                key=node.name,
            )
        table.move_cursor(row=min(previous, table.row_count - 1))

    async def set_exit_node(self, name: str) -> None:
        code, _, err = await tailscale('set', f'--exit-node={name}')
        if code != 0:
            hint = ' (try: sudo tailscale set --operator=$USER)' if 'denied' in err.lower() else ''
            self.notify(f'{err.strip()}{hint}', severity='error', timeout=8)
            return
        for node in self.nodes:
            node.is_exit = node.name == name
        self.repopulate()
        self.update_subtitle()
        self.notify(f'exit node: {name or "none"}')

    def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        if event.row_key.value:
            self.run_worker(self.set_exit_node(event.row_key.value), exclusive=True)

    def on_input_changed(self, _: Input.Changed) -> None:
        self.repopulate()

    def on_input_submitted(self, _: Input.Submitted) -> None:
        self.query_one(DataTable).focus()

    def action_clear_exit(self) -> None:
        self.run_worker(self.set_exit_node(''), exclusive=True)

    def action_use_suggested(self) -> None:
        if self.suggested:
            self.run_worker(self.set_exit_node(self.suggested), exclusive=True)
        else:
            self.notify('no suggestion (yet)', severity='warning')

    def action_toggle_all(self) -> None:
        self.show_all = not self.show_all
        self.repopulate()

    def action_sort_distance(self) -> None:
        self.sort_by = 'distance'
        self.repopulate()

    def action_sort_latency(self) -> None:
        self.sort_by = 'latency'
        self.repopulate()

    def action_refresh(self) -> None:
        self.run_worker(self.load(), exclusive=True)

    def action_focus_filter(self) -> None:
        self.query_one(Input).focus()

    def action_focus_table(self) -> None:
        self.query_one(DataTable).focus()


async def dump(gateway: str | None) -> None:
    (nodes, regions), uplink = await asyncio.gather(load_nodes(), lan_uplink(gateway))
    print(f'probing via {f"{uplink.gateway} ({uplink.dev})" if uplink else "system route"}')
    await estimate_latencies(nodes, regions, uplink)
    for node in sort_nodes(collapse_by_city(nodes), 'distance'):
        distance = f'{node.distance:7.0f}' if node.distance is not None else '      ?'
        est = f'{node.est_ms:5.0f}' if node.est_ms is not None else '    ?'
        mark = '*' if node.is_exit else ' '
        print(f'{mark}{distance} km {est} ms  {node.country or "—":<16} {node.city or "—":<16} {node.name}')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--dump', action='store_true', help='plain-text listing instead of the TUI')
    parser.add_argument('--gateway', metavar='IP', help='send probes via this main-table default gateway')
    args = parser.parse_args()
    if args.dump:
        asyncio.run(dump(args.gateway))
    else:
        ExitNodePicker(args.gateway).run()
